{
  "name": "focsera",
  "version": "1.0.0",
  "type": "module",
  "description": "Focsera - Complete Invoice Generator & Ledger Management System",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/src/server.js",
    "test": "npm --prefix server run test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "keywords": [
    "focsera",
    "invoice",
    "ledger",
    "accounting",
    "quotation"
  ],
  "author": "Focsera Team",
  "license": "UNLICENSED"
}

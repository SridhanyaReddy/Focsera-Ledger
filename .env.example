# Focsera Financial Management System Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=focsera-production-secure-financial-ledger-jwt-secret-key-2026

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB instance)
# If omitted or unavailable, the system automatically runs with an embedded in-memory MongoDB instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/focsera?retryWrites=true&w=majority

